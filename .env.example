# .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── Flask environment ─────────────────────────────────────────────────────────
FLASK_ENV=production
# FLASK_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/var/www/securedesk/securedesk.db

# ── Admin account (used by: python manage.py create-admin) ───────────────────
ADMIN_EMAIL=admin@yourdomain.example
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── Session cookies ───────────────────────────────────────────────────────────
# Set to true only when HTTPS is configured
SESSION_COOKIE_SECURE=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIR=/var/www/securedesk/logs
