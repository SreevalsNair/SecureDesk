# .gitignore
# Security: never commit secrets, database files, or private keys

# Environment and secrets
.env
*.pem
*.key

# Database
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
