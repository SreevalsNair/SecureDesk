[Unit]
Description=SecureDesk Gunicorn service
After=network.target

[Service]
# Security: runs as a non-root dedicated user
User=securedesk
Group=securedesk
WorkingDirectory=/var/www/securedesk

# Load environment variables from .env file
EnvironmentFile=/var/www/securedesk/.env

# Gunicorn: 2 workers is enough for a t4g.micro (1 vCPU, 1 GB RAM)
# --preload shares the in-memory rate-limit store across worker forks (same process)
ExecStart=/var/www/securedesk/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile /var/www/securedesk/logs/access.log \
    --error-logfile /var/www/securedesk/logs/error.log \
    --log-level info \
    --timeout 30 \
    wsgi:app

# Restart on failure
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/securedesk/logs /var/www/securedesk

[Install]
WantedBy=multi-user.target
